PORT=3001
FRONTEND_ORIGIN=*
FRONTEND_URL=https://avg-ai-creator.site

# NVIDIA NIM API Key (Powers moonshotai/kimi-k3 2.8T MoE model)
NVIDIA_API_KEY=nvapi-your-nvidia-key-here

# Groq LPU API Key (Powers openai/gpt-oss-120b & qwen3.8-27b)
GROQ_API_KEY=gsk_your-groq-key-here

# OpenRouter API Key (200+ AI modellarni ulash uchun)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Render PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Token Secret
JWT_SECRET=oryxgen-ultra-secret-key-2026

# Google OAuth 2.0 (console.cloud.google.com dan olinadi)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
